<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/taskItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/widget_task_bg"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:layout_marginBottom="4dp">

    <ImageView
        android:id="@+id/taskItemDot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/widget_status_dot"
        android:contentDescription="status"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp">

        <TextView
            android:id="@+id/taskItemTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Даалгавар"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/widget_task_title"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/taskItemTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="09:00 - 10:30"
            android:textSize="13sp"
            android:textColor="@color/widget_task_time"/>
    </LinearLayout>

    <TextView
        android:id="@+id/taskItemStatus"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:gravity="center"
        android:text="Эхлэх"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/widget_btn_start"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"/>
</LinearLayout>
