### Step 3: Register FCM Token

```javascript
import messaging from '@react-native-firebase/messaging';
import { Platform } from 'react-native';

async function registerFCMToken() {
  try {
    // Request permission (iOS)
    if (Platform.OS === 'ios') {
      const authStatus = await messaging().requestPermission();
      if (authStatus === messaging.AuthorizationStatus.AUTHORIZED ||
          authStatus === messaging.AuthorizationStatus.PROVISIONAL) {
        console.log('Permission granted');
      } else {
        console.warn('Permission denied');
        return;
      }
    }

    // Get FCM token
    const fcmToken = await messaging().getToken();
    console.log('FCM Token:', fcmToken);

    // Register with backend
    const userId = getUserId(); // Get from AsyncStorage, token, etc.
    const response = await fetch('http://localhost:8000/fcm/register', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        ajiltniiId: userId,
        token: fcmToken,
        deviceType: Platform.OS, // 'ios' or 'android'
        deviceId: getDeviceId(), // Optional
        appVersion: '1.0.0' // Optional
      })
    });

    const result = await response.json();
    if (result.success) {
      console.log('✅ FCM token registered');
    }
  } catch (error) {
    console.error('❌ Error:', error);
  }
}

// Call on app start
registerFCMToken();

// Handle token refresh
messaging().onTokenRefresh((token) => {
  console.log('Token refreshed:', token);
  registerFCMToken(); // Re-register with new token
});
```

### Step 4: Handle Notifications

```javascript
import messaging from '@react-native-firebase/messaging';
import { Alert } from 'react-native';

// Handle foreground notifications
messaging().onMessage(async (remoteMessage) => {
  console.log('Foreground message:', remoteMessage);
  
  Alert.alert(
    remoteMessage.notification?.title || 'Notification',
    remoteMessage.notification?.body || '',
    [{ text: 'OK' }]
  );
  
  // Update notification badge
  updateNotificationBadge();
});

// Handle background/quit state notifications
messaging().setBackgroundMessageHandler(async (remoteMessage) => {
  console.log('Background message:', remoteMessage);
});

// Handle notification opened from quit state
messaging()
  .getInitialNotification()
  .then((remoteMessage) => {
    if (remoteMessage) {
      console.log('Notification opened app:', remoteMessage);
      // Navigate to relevant screen
      handleNotificationNavigation(remoteMessage.data);
    }
  });

// Handle notification opened from background
messaging().onNotificationOpenedApp((remoteMessage) => {
  console.log('Notification opened app from background:', remoteMessage);
  handleNotificationNavigation(remoteMessage.data);
});
```

