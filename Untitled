### Step 2: Register FCM Token

```dart
import 'package:firebase_messaging/firebase_messaging.dart';
import 'package:http/http.dart' as http;
import 'dart:convert';

Future<void> registerFCMToken() async {
  try {
    // Request permission (iOS)
    NotificationSettings settings = await FirebaseMessaging.instance.requestPermission(
      alert: true,
      badge: true,
      sound: true,
    );

    if (settings.authorizationStatus == AuthorizationStatus.authorized) {
      // Get FCM token
      String? fcmToken = await FirebaseMessaging.instance.getToken();
      
      if (fcmToken != null) {
        print('FCM Token: $fcmToken');
        
        // Register with backend
        String userId = getUserId(); // Get from SharedPreferences, etc.
        final response = await http.post(
          Uri.parse('http://localhost:8000/fcm/register'),
          headers: {'Content-Type': 'application/json'},
          body: jsonEncode({
            'ajiltniiId': userId,
            'token': fcmToken,
            'deviceType': Platform.isIOS ? 'ios' : 'android',
            'appVersion': '1.0.0'
          }),
        );

        if (response.statusCode == 200) {
          print('✅ FCM token registered');
        }
      }
    }
  } catch (e) {
    print('❌ Error: $e');
  }
}

// Call on app start
registerFCMToken();

// Handle token refresh
FirebaseMessaging.instance.onTokenRefresh.listen((newToken) {
  print('Token refreshed: $newToken');
  registerFCMToken(); // Re-register
});
```

### Step 3: Handle Notifications

```dart
import 'package:firebase_messaging/firebase_messaging.dart';

// Handle foreground notifications
Future<void> _firebaseMessagingBackgroundHandler(RemoteMessage message) async {
  print('Background message: ${message.messageId}');
}

void main() {
  // Initialize background handler
  FirebaseMessaging.onBackgroundMessage(_firebaseMessagingBackgroundHandler);
  
  runApp(MyApp());
}

// In your app widget
class MyApp extends StatefulWidget {
  @override
  _MyAppState createState() => _MyAppState();
}

class _MyAppState extends State<MyApp> {
  @override
  void initState() {
    super.initState();
    
    // Handle foreground messages
    FirebaseMessaging.onMessage.listen((RemoteMessage message) {
      print('Foreground message: ${message.notification?.title}');
      
      // Show local notification
      showLocalNotification(
        message.notification?.title ?? 'Notification',
        message.notification?.body ?? '',
      );
    });

    // Handle notification opened from background
    FirebaseMessaging.onMessageOpenedApp.listen((RemoteMessage message) {
      print('Notification opened: ${message.data}');
      handleNotificationNavigation(message.data);
    });

    // Handle notification opened from quit state
    FirebaseMessaging.instance.getInitialMessage().then((RemoteMessage? message) {
      if (message != null) {
        handleNotificationNavigation(message.data);
      }
    });
  }
}
```

